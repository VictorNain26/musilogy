{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy*)",
      "Bash(uv run musilogy *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)"
    ],
    "ask": [
      "Bash(uv run musilogy run*)"
    ],
    "deny": [
      "Edit(/tests/fixtures/**)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.py)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ruff.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "ruff"
          }
        ]
      }
    ]
  }
}
